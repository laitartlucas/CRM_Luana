# -----------------------------------------------------------------------
# Banco de dados / fila
# -----------------------------------------------------------------------
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm_styling?schema=public"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_TLS="false"

# -----------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------
PORT="3000"
NODE_ENV="development"
WEB_APP_URL="http://localhost:5173"
API_PUBLIC_URL="http://localhost:3000"
DEFAULT_TIMEZONE="America/Sao_Paulo"

# -----------------------------------------------------------------------
# Autenticação
# -----------------------------------------------------------------------
JWT_ACCESS_SECRET="troque-por-um-segredo-forte-de-32-bytes"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="troque-por-outro-segredo-forte-de-32-bytes"
JWT_REFRESH_TTL="7d"
# Chave de 32 bytes em base64 usada para criptografar tokens do Google em repouso.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="gere-uma-chave-de-32-bytes-em-base64"

# Login social com Google (distinto do OAuth de sincronização de agenda abaixo)
GOOGLE_LOGIN_CLIENT_ID=""
GOOGLE_LOGIN_CLIENT_SECRET=""
GOOGLE_LOGIN_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# -----------------------------------------------------------------------
# Google Calendar (sincronização de agenda por profissional)
# Criar em https://console.cloud.google.com — ativar "Google Calendar API"
# -----------------------------------------------------------------------
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/calendar-sync/oauth/callback"
# URL pública HTTPS necessária para o Google enviar push notifications (produção).
GOOGLE_CALENDAR_WEBHOOK_URL="https://SEU-DOMINIO-PUBLICO/calendar-sync/webhook"

# -----------------------------------------------------------------------
# WhatsApp — Meta Cloud API
# WHATSAPP_PROVIDER=mock  -> usa MockWhatsappProvider (nenhuma credencial necessária)
# WHATSAPP_PROVIDER=meta  -> usa a Meta Cloud API de verdade
# -----------------------------------------------------------------------
WHATSAPP_PROVIDER="mock"
WHATSAPP_META_PHONE_NUMBER_ID=""
WHATSAPP_META_ACCESS_TOKEN=""
WHATSAPP_META_VERIFY_TOKEN="escolha-uma-string-qualquer-para-o-webhook"
WHATSAPP_META_APP_SECRET=""

# -----------------------------------------------------------------------
# Regras de negócio configuráveis
# -----------------------------------------------------------------------
LATE_CANCEL_HOURS="12"
REMINDER_HOURS_BEFORE="24,1"
