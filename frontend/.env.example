# Em dev, o proxy do Vite (vite.config.ts) já encaminha /api para o backend
# local — não precisa definir nada. Em produção (front e back em domínios
# diferentes), aponte para a URL pública da API:
VITE_API_URL="https://sua-api.exemplo.com"

# URL pública direta do backend (sem passar pelo proxy /api do frontend).
# Usada só pro link "Conectar Google Calendar" — precisa bater com o domínio
# cadastrado em GOOGLE_CALENDAR_REDIRECT_URI no backend, senão o cookie de
# estado da autorização OAuth não sobrevive ao redirect de volta do Google.
VITE_API_PUBLIC_URL="https://sua-api.exemplo.com"
